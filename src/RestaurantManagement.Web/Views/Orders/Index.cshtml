@model OrderIndexViewModel
@{
    ViewData["Title"] = "Gọi món";
    var statusClasses = new Dictionary<byte, string>
    {
        [0] = "bg-warning text-dark",
        [1] = "bg-primary",
        [2] = "bg-success",
        [3] = "bg-secondary",
    };
    var statusLabels = new Dictionary<byte, string>
    {
        [0] = "Đang chờ",
        [1] = "Đang chế biến",
        [2] = "Hoàn thành",
        [3] = "Đã hủy",
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Gọi món</h1>
        <p class="text-muted mb-0">Chọn bàn để mở hóa đơn hoặc xem lượt phục vụ đang diễn ra.</p>
    </div>
    <a asp-controller="Kitchen" asp-action="Queue" class="btn btn-outline-primary">Hàng đợi bếp</a>
</div>
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-2 mb-4">
    @foreach (var table in Model.Tables)
    {
        var isSelected = Model.SelectedTableId == table.TableId;
        var statusClass = table.StatusName switch
        {
            "Trống" => "border-success",
            "Có khách" => "border-primary",
            "Đang đợi món" => "border-warning",
            "Món đã xong" => "border-info",
            _ => "border-secondary",
        };
        <div class="col-6 col-md-4 col-lg-3 col-xl-2">
            <a asp-action="Index" asp-route-tableId="@table.TableId"
               class="card h-100 text-decoration-none text-reset @statusClass @(isSelected ? "shadow border-2" : "")">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="fw-semibold">@table.TableNumber</span>
                        <span class="badge @(table.StatusName == "Trống" ? "bg-success" : "bg-secondary")">@table.StatusName</span>
                    </div>
                    <div class="small text-muted mt-1">@(table.AreaName ?? "Chưa phân khu") · @table.MaxSeats chỗ</div>
                    @if (table.InvoiceCode is not null)
                    {
                        <div class="small mt-1">@table.InvoiceCode</div>
                    }
                </div>
            </a>
        </div>
    }
</div>

@if (Model.Invoice is not null)
{
    <section class="card mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h2 class="h5 mb-0">Hóa đơn @Model.Invoice.InvoiceCode</h2>
                <span class="small text-muted">
                    Bàn: @string.Join(", ", Model.Invoice.Tables.Select(t => t.Number))
                    · @Model.Invoice.CustomerCount khách
                    · Mở lúc @Model.Invoice.OpenedAt.ToLocalTime().ToString("dd/MM HH:mm")
                </span>
            </div>
            <strong class="fs-5 text-primary">@Model.Invoice.Subtotal.ToString("N0") đ</strong>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Món</th><th>Ghi chú</th><th class="text-end">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th><th>Trạng thái</th><th>Thao tác</th></tr>
                </thead>
                <tbody>
                @if (Model.Invoice.Items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Chưa gọi món.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Invoice.Items)
                    {
                        <tr class="@(item.Status == 3 ? "text-muted" : "")">
                            <td><span class="fw-semibold">@item.ItemName</span><div class="small text-muted">@item.ItemCode</div></td>
                            <td>@(item.Note ?? "—")</td>
                            <td class="text-end">@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("N0") đ</td>
                            <td class="text-end">@((item.Quantity * item.UnitPrice).ToString("N0")) đ</td>
                            <td>
                                <span class="badge @statusClasses[item.Status]">@statusLabels[item.Status]</span>
                                @if (item.Status == 3 && !string.IsNullOrWhiteSpace(item.CancelReason))
                                {
                                    <div class="small">@item.CancelReason</div>
                                }
                            </td>
                            <td>
                                @if (item.Status == 0)
                                {
                                    <form asp-action="CancelItem" method="post" class="d-flex gap-1 mb-2">
                                        <input type="hidden" name="InvoiceId" value="@Model.Invoice.Id" />
                                        <input type="hidden" name="DetailId" value="@item.Id" />
                                        <input name="Reason" class="form-control form-control-sm" maxlength="255"
                                               placeholder="Lý do hủy" required aria-label="Lý do hủy @item.ItemName" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">Hủy món</button>
                                    </form>
                                    @if (Model.MenuItems.Count > 0)
                                    {
                                        <details>
                                            <summary class="small text-primary">Đổi món</summary>
                                            <form asp-action="ReplaceItem" method="post" class="mt-2">
                                                <input type="hidden" name="InvoiceId" value="@Model.Invoice.Id" />
                                                <input type="hidden" name="DetailId" value="@item.Id" />
                                                <select name="MenuItemId" class="form-select form-select-sm mb-1" required
                                                        aria-label="Món thay thế cho @item.ItemName">
                                                    <option value="">-- Chọn món thay thế --</option>
                                                    @foreach (var menuItem in Model.MenuItems)
                                                    {
                                                        <option value="@menuItem.Id">@menuItem.Name — @menuItem.Price.ToString("N0") đ</option>
                                                    }
                                                </select>
                                                <input name="Quantity" type="number" min="1" max="1000" value="@item.Quantity"
                                                       class="form-control form-control-sm mb-1" required aria-label="Số lượng món thay thế" />
                                                <input name="Note" maxlength="255" class="form-control form-control-sm mb-1"
                                                       placeholder="Ghi chú món mới (không bắt buộc)" />
                                                <input name="Reason" maxlength="255" class="form-control form-control-sm mb-1"
                                                       placeholder="Lý do đổi món" required />
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Đổi món</button>
                                            </form>
                                        </details>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <div class="card-body border-top">
            <h3 class="h6">Gọi thêm món</h3>
            @if (Model.MenuItems.Count == 0)
            {
                <div class="text-muted small">Hiện không có món còn bán.</div>
            }
            else
            {
                <form asp-action="AddItem" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="InvoiceId" value="@Model.Invoice.Id" />
                    <div class="col-md-5">
                        <label for="menuItemId" class="form-label">Món</label>
                        <select id="menuItemId" name="MenuItemId" class="form-select" required>
                            <option value="">-- Chọn món --</option>
                            @foreach (var item in Model.MenuItems)
                            {
                                <option value="@item.Id">@item.CategoryName · @item.Name — @item.Price.ToString("N0") đ/@(item.Unit ?? "phần")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="quantity" class="form-label">Số lượng</label>
                        <input id="quantity" name="Quantity" type="number" min="1" max="1000" value="1" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label for="note" class="form-label">Ghi chú</label>
                        <input id="note" name="Note" maxlength="255" class="form-control" placeholder="Ít cay, không hành..." />
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary">Thêm món</button>
                    </div>
                </form>
            }
        </div>
        <div class="card-body border-top">
            <h3 class="h6">Chuyển bàn / gộp bàn</h3>
            <div class="row g-3">
                <div class="col-lg-6">
                    <form asp-action="MoveTable" method="post" class="row g-2 align-items-end">
                        <input type="hidden" name="invoiceId" value="@Model.Invoice.Id" />
                        <div class="col-4">
                            <label class="form-label" for="fromTableId">Bàn hiện tại</label>
                            <select id="fromTableId" name="fromTableId" class="form-select" required>
                                @foreach (var table in Model.Invoice.Tables)
                                {
                                    <option value="@table.Id">@table.Number</option>
                                }
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label" for="toTableId">Bàn trống</label>
                            <select id="toTableId" name="toTableId" class="form-select" required>
                                @foreach (var table in Model.Tables.Where(t => t.StatusName == "Trống"))
                                {
                                    <option value="@table.TableId">@table.TableNumber</option>
                                }
                            </select>
                        </div>
                        <div class="col-4 d-grid">
                            <button type="submit" class="btn btn-outline-primary">Chuyển bàn</button>
                        </div>
                        <div class="col-12">
                            <input name="note" maxlength="255" class="form-control form-control-sm" placeholder="Ghi chú chuyển bàn (không bắt buộc)" />
                        </div>
                    </form>
                </div>
                <div class="col-lg-6">
                    @{
                        var mergeCandidates = Model.ActiveInvoices.Where(i => i.Id != Model.Invoice.Id).ToList();
                    }
                    @if (mergeCandidates.Count > 0)
                    {
                        <form asp-action="Merge" method="post" class="row g-2 align-items-end"
                              onsubmit="return confirm('Gộp hóa đơn được chọn vào hóa đơn hiện tại?');">
                            <input type="hidden" name="targetInvoiceId" value="@Model.Invoice.Id" />
                            <div class="col-8">
                                <label for="sourceInvoiceId" class="form-label">Gộp hóa đơn khác vào hóa đơn này</label>
                                <select id="sourceInvoiceId" name="sourceInvoiceId" class="form-select" required>
                                    @foreach (var candidate in mergeCandidates)
                                    {
                                        <option value="@candidate.Id">
                                            @candidate.InvoiceCode · @string.Join(", ", candidate.Tables.Select(t => t.Number)) · @candidate.Subtotal.ToString("N0") đ
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-4 d-grid">
                                <button type="submit" class="btn btn-outline-danger">Gộp hóa đơn</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="small text-muted">Không có hóa đơn khác để gộp.</div>
                    }
                </div>
            </div>
        </div>
    </section>
}
else if (Model.SelectedTableId.HasValue)
{
    var selectedTable = Model.Tables.FirstOrDefault(t => t.TableId == Model.SelectedTableId);
    if (selectedTable is null)
    {
        <div class="alert alert-warning">Bàn này hiện không được phục vụ hoặc không tồn tại.</div>
    }
    else if (selectedTable.InvoiceId.HasValue)
    {
        <div class="alert alert-info">
            Bàn @selectedTable.TableNumber đang phục vụ hóa đơn @selectedTable.InvoiceCode.
            <a asp-action="Index" asp-route-invoiceId="@selectedTable.InvoiceId">Mở hóa đơn</a>
        </div>
    }
    else
    {
        <section class="card">
            <div class="card-body">
                <h2 class="h5">Mở bàn @selectedTable.TableNumber</h2>
                <p class="text-muted small">Sức chứa tối đa @selectedTable.MaxSeats khách.</p>
                <form asp-action="Open" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="TableId" value="@selectedTable.TableId" />
                    <div class="col-sm-4">
                        <label class="form-label" asp-for="OpenInvoice.CustomerCount"></label>
                        <input name="CustomerCount" type="number" min="1" max="100" value="1" class="form-control" required />
                    </div>
                    <div class="col-sm-4 d-grid">
                        <button type="submit" class="btn btn-primary">Mở bàn và tạo hóa đơn</button>
                    </div>
                </form>
            </div>
        </section>
    }
}
