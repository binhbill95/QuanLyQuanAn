@model DiningTableFormViewModel
@{
    ViewData["Title"] = "Thêm bàn";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Thêm bàn</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Danh sách bàn</a>
</div>
<div class="card"><div class="card-body">
    <form asp-action="Create" method="post">
        <partial name="_TableFormFields" model="Model" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Lưu bàn</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
