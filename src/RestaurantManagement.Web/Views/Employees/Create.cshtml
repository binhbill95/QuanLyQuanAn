@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Thêm nhân viên";
}

<h1 class="h3 mb-3">Thêm nhân viên</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <partial name="_FormFields" model="Model" />

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
