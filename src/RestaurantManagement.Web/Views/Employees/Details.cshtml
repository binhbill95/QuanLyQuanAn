@model EmployeeDetailsDto
@{
    ViewData["Title"] = "Chi tiết nhân viên";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.FullName</h1>
        <p class="text-muted mb-0">
            <span class="fw-semibold">@Model.EmployeeCode</span> ·
            @Model.PositionName ·
            <span class="badge @EmployeeDisplay.StatusBadgeClass(Model.Status)">@EmployeeDisplay.StatusLabel(Model.Status)</span>
        </p>
    </div>
    <div>
        <a asp-controller="Shifts" asp-action="Assign" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Phân ca</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Sửa</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Danh sách</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="text-muted small">Giới tính</div>
                <div>@EmployeeDisplay.GenderLabel(Model.Gender)</div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Ngày sinh</div>
                <div>@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Số CCCD/CMND</div>
                <div>@Model.IdentityNumber</div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Điện thoại</div>
                <div>@(Model.Phone ?? "—")</div>
            </div>
            <div class="col-12">
                <div class="text-muted small">Địa chỉ</div>
                <div>@(Model.Address ?? "—")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Ngày vào làm</div>
                <div>@Model.StartDate.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Ngày nghỉ</div>
                <div>@(Model.EndDate?.ToString("dd/MM/yyyy") ?? "—")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Đơn giá ca</div>
                <div>@(Model.ShiftRate.HasValue ? Model.ShiftRate.Value.ToString("N0") + " đ" : "Theo vị trí")</div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Ca có thể làm</div>
                <div>
                    @if (Model.ShiftNames.Count == 0)
                    {
                        <span class="text-muted">Chưa phân ca</span>
                    }
                    else
                    {
                        @foreach (var shiftName in Model.ShiftNames)
                        {
                            <span class="badge bg-light text-dark border me-1">@shiftName</span>
                        }
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Tài khoản đăng nhập</div>
                <div>
                    @(Model.Username ?? "Chưa có tài khoản")
                    @if (User.IsInRole("ADMIN"))
                    {
                        @if (Model.Username is null)
                        {
                            <a asp-controller="Accounts" asp-action="Create" asp-route-employeeId="@Model.Id"
                               class="small ms-2">Tạo tài khoản</a>
                        }
                        else
                        {
                            <a asp-controller="Accounts" asp-action="Index" asp-route-keyword="@Model.Username"
                               class="small ms-2">Quản lý tài khoản</a>
                        }
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Ghi chú</div>
                <div>@(Model.Note ?? "—")</div>
            </div>
        </div>
    </div>
    <div class="card-footer text-muted small">
        Tạo lúc @DateTime.SpecifyKind(Model.CreatedAt, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")
        @if (Model.UpdatedAt.HasValue)
        {
            <text> · Cập nhật @DateTime.SpecifyKind(Model.UpdatedAt.Value, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")</text>
        }
    </div>
</div>

<div class="mt-3">
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
          onsubmit="return confirm('Xóa nhân viên @Model.FullName?');">
        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa nhân viên</button>
    </form>
</div>
