@model RestaurantManagement.Application.Models.Payments.PaymentReceiptDto
@{
    ViewData["Title"] = "Hóa đơn thanh toán";
}

<style>
    @@media print {
        header, footer, .no-print { display: none !important; }
        body { background: #fff !important; }
        main { padding: 0 !important; }
        .receipt { border: 0 !important; box-shadow: none !important; }
    }
</style>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success no-print">@successMessage</div>
}

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <a asp-action="Index" class="btn btn-outline-secondary">Danh sách thanh toán</a>
    <button type="button" class="btn btn-primary" onclick="window.print()">In hóa đơn</button>
</div>

<section class="card receipt mx-auto" style="max-width: 760px;">
    <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
            <h1 class="h3">HÓA ĐƠN THANH TOÁN</h1>
            <div class="text-muted">Quản lý quán ăn</div>
            <div class="mt-2 fw-semibold">@Model.InvoiceCode</div>
        </div>
        <div class="row mb-3">
            <div class="col-6"><strong>Bàn:</strong> @string.Join(", ", Model.Tables.Select(table => table.Number))</div>
            <div class="col-6 text-end"><strong>Số khách:</strong> @Model.CustomerCount</div>
            <div class="col-6"><strong>Bắt đầu:</strong> @Model.OpenedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            <div class="col-6 text-end"><strong>Thanh toán:</strong> @Model.PaidAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr><th>Món</th><th class="text-end">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items.Where(item => item.Status != 3))
                    {
                        <tr>
                            <td>@item.ItemName</td>
                            <td class="text-end">@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("N0") đ</td>
                            <td class="text-end">@((item.Quantity * item.UnitPrice).ToString("N0")) đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ms-auto" style="max-width: 360px;">
            <div class="d-flex justify-content-between"><span>Tạm tính</span><span>@Model.Subtotal.ToString("N0") đ</span></div>
            <div class="d-flex justify-content-between"><span>Giảm giá</span><span>@Model.DiscountAmount.ToString("N0") đ</span></div>
            <div class="d-flex justify-content-between border-top mt-2 pt-2 fs-5 fw-bold">
                <span>Đã thanh toán</span><span>@Model.AmountPaid.ToString("N0") đ</span>
            </div>
        </div>

        <div class="mt-3 small text-muted">
            Phương thức: @(Model.Method == 0 ? "Tiền mặt" : "Chuyển khoản") ·
            Thu ngân: @Model.PaidByEmployeeName
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Note))
        {
            <div class="small text-muted">Ghi chú: @Model.Note</div>
        }
        <div class="text-center mt-5">Cảm ơn quý khách!</div>
    </div>
</section>
