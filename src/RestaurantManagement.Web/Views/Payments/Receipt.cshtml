@model RestaurantManagement.Web.Models.PaymentReceiptViewModel
@{
    ViewData["Title"] = "Hóa đơn thanh toán";
    var receipt = Model.Receipt;
}

<style>
    @@media print {
        header, footer, .no-print { display: none !important; }
        body { background: #fff !important; }
        main { padding: 0 !important; }
        .receipt { border: 0 !important; box-shadow: none !important; }
    }
</style>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success no-print">@successMessage</div>
}

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <a asp-action="Index" class="btn btn-outline-secondary">Danh sách thanh toán</a>
    <button type="button" class="btn btn-primary" onclick="window.print()">In hóa đơn</button>
</div>

<section class="card receipt mx-auto" style="max-width: 760px;">
    <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
            <h1 class="h3">HÓA ĐƠN THANH TOÁN</h1>
            <div class="text-muted">Quản lý quán ăn</div>
            <div class="mt-2 fw-semibold">@receipt.InvoiceCode</div>
        </div>
        <div class="row mb-3">
            <div class="col-6"><strong>Bàn:</strong> @string.Join(", ", receipt.Tables.Select(table => table.Number))</div>
            <div class="col-6 text-end"><strong>Số khách:</strong> @receipt.CustomerCount</div>
            <div class="col-6"><strong>Bắt đầu:</strong> @receipt.OpenedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            <div class="col-6 text-end"><strong>Thanh toán:</strong> @receipt.PaidAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr><th>Món</th><th class="text-end">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in receipt.Items.Where(item => item.Status != 3))
                    {
                        <tr>
                            <td>@item.ItemName</td>
                            <td class="text-end">@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("N0") đ</td>
                            <td class="text-end">@((item.Quantity * item.UnitPrice).ToString("N0")) đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ms-auto" style="max-width: 360px;">
            <div class="d-flex justify-content-between"><span>Tạm tính</span><span>@receipt.Subtotal.ToString("N0") đ</span></div>
            <div class="d-flex justify-content-between"><span>Giảm giá</span><span>@receipt.DiscountAmount.ToString("N0") đ</span></div>
            <div class="d-flex justify-content-between border-top mt-2 pt-2 fs-5 fw-bold">
                <span>Đã thanh toán</span><span>@receipt.AmountPaid.ToString("N0") đ</span>
            </div>
        </div>

        <div class="mt-3 small text-muted">
            Phương thức: @(receipt.Method == 0 ? "Tiền mặt" : "Chuyển khoản") ·
            Thu ngân: @receipt.PaidByEmployeeName
        </div>
        @if (!string.IsNullOrWhiteSpace(receipt.Note))
        {
            <div class="small text-muted">Ghi chú: @receipt.Note</div>
        }
        @if (receipt.Method == 1 && Model.Bank.IsConfigured)
        {
            <div class="text-center border-top mt-4 pt-4">
                <h2 class="h6">Thông tin chuyển khoản</h2>
                <div>@Model.Bank.BankName · STK <span class="font-monospace">@Model.Bank.AccountNumber</span></div>
                <div>Chủ tài khoản: @Model.Bank.AccountName</div>
                @if (!string.IsNullOrWhiteSpace(Model.Bank.Branch))
                {
                    <div>Chi nhánh: @Model.Bank.Branch</div>
                }
                <img src="@Url.Action("ReceiptTransferQr", "Payments", new { invoiceId = receipt.InvoiceId })"
                     class="img-fluid mt-2"
                     style="width: 200px; height: 200px"
                     alt="Mã QR thanh toán VietQR" />
                <div class="small text-muted">Mã QR chứa số tiền và mã hóa đơn để tiện đối chiếu.</div>
            </div>
        }
        <div class="text-center mt-5">Cảm ơn quý khách!</div>
    </div>
</section>
