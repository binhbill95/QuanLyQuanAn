@model IReadOnlyList<CategoryDto>
@{
    ViewData["Title"] = "Nhóm món";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Nhóm món</h1>
        <p class="text-muted mb-0">Khai vị, món chính, tráng miệng, đồ uống…</p>
    </div>
    <div>
        <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary">Thực đơn</a>
        <a asp-action="Create" class="btn btn-primary">+ Thêm nhóm</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã</th>
                <th>Tên nhóm</th>
                <th>Thứ tự</th>
                <th>Số món</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Chưa có nhóm món nào.</td>
                </tr>
            }
            else
            {
                @foreach (var category in Model)
                {
                    <tr>
                        <td class="fw-semibold">@category.Code</td>
                        <td>@category.Name</td>
                        <td>@category.DisplayOrder</td>
                        <td>@category.ItemCount</td>
                        <td>
                            @if (category.IsActive)
                            {
                                <span class="badge bg-success">Đang sử dụng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngừng</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">Sửa</a>

                            <form asp-action="ToggleActive" asp-route-id="@category.Id" method="post" class="d-inline">
                                <input type="hidden" name="isActive" value="@(category.IsActive ? "false" : "true")" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(category.IsActive ? "Ngừng" : "Kích hoạt")
                                </button>
                            </form>

                            <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Xóa nhóm món này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
