@model IReadOnlyList<ShiftDto>
@{
    ViewData["Title"] = "Ca làm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Ca làm</h1>
        <p class="text-muted mb-0">Cấu hình ca và phân ca cho nhân viên</p>
    </div>
    <div>
        <a asp-action="Assignments" class="btn btn-outline-primary">Phân ca nhân viên</a>
        <a asp-action="Create" class="btn btn-primary">+ Thêm ca</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Tên ca</th>
                <th>Giờ làm</th>
                <th>Nhân viên được phân</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Chưa có ca làm nào.</td>
                </tr>
            }
            else
            {
                @foreach (var shift in Model)
                {
                    <tr>
                        <td class="fw-semibold">@shift.Name</td>
                        <td>@shift.StartTime.ToString("HH:mm") – @shift.EndTime.ToString("HH:mm")</td>
                        <td>@shift.AssignedEmployees</td>
                        <td>
                            @if (shift.IsActive)
                            {
                                <span class="badge bg-success">Đang sử dụng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngừng</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@shift.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="ToggleActive" asp-route-id="@shift.Id" method="post" class="d-inline">
                                <input type="hidden" name="isActive" value="@(shift.IsActive ? "false" : "true")" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(shift.IsActive ? "Ngừng" : "Kích hoạt")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
