@model AssignShiftsViewModel
@{
    ViewData["Title"] = "Phân ca";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Phân ca cho @Model.EmployeeName</h1>
        <p class="text-muted mb-0">@Model.EmployeeCode · @Model.PositionName</p>
    </div>
    <a asp-action="Assignments" class="btn btn-outline-secondary">Quay lại</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Assign" asp-route-id="@Model.EmployeeId" method="post">
            @if (Model.Shifts.Count == 0)
            {
                <p class="text-muted mb-0">Chưa có ca làm nào. Hãy tạo ca trước.</p>
            }
            else
            {
                <div class="row g-2">
                    @foreach (var shift in Model.Shifts)
                    {
                        <div class="col-md-4">
                            <div class="form-check border rounded p-3 ps-5">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="shiftIds"
                                       value="@shift.Id"
                                       id="shift-@shift.Id"
                                       checked="@shift.Selected" />
                                <label class="form-check-label" for="shift-@shift.Id">
                                    <span class="fw-semibold">@shift.Name</span><br />
                                    <span class="text-muted small">
                                        @shift.StartTime.ToString("HH:mm") – @shift.EndTime.ToString("HH:mm")
                                    </span>
                                </label>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Lưu phân ca</button>
                </div>
            }
        </form>
    </div>
</div>
